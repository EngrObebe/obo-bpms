rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Approved OBO accounts. Keep this list updated when onboarding/removing staff.
    function isStaff() {
      return request.auth != null && request.auth.token.email in [
        'michaelvincentestradaobena2019@gmail.com'
      ];
    }
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'michaelvincentestradaobena2019@gmail.com';
    }
    // Existing shared-record buckets, including assessments and audit log.
    match /obo/{bucket} {
      allow read, create: if isStaff();
      // Removal of individual assessment bucket fields requires the Building Official.
      allow update: if isStaff() && (
        !bucket.matches('a-[0-9]+') || isAdmin() ||
        !('items' in resource.data) || !('items' in request.resource.data) ||
        request.resource.data.items.diff(resource.data.items).removedKeys().size() == 0
      );
      allow delete: if isAdmin();
    }
    match /photos/{photoId} {
      allow read, write: if isStaff();
    }
    // Atomic control-number allocation / recovery. In this installation,
    // the authorized Building Official is currently the sole approved staff account.
    // v1.5: public documents are carefully curated, token-addressed views.
    // An unguessable 192-bit token is required; browsing/search is prohibited.
    // Neither collection contains applicant names, contact numbers, uploaded
    // documents, technical assessments, exact addresses, or map coordinates.
    function publicTrackingShape() {
      return request.resource.data.keys().hasOnly([
        'kind','state','applicationNo','stage','next','received','barangay','updatedAt','schema'
      ]) && request.resource.data.keys().hasAll([
        'kind','state','applicationNo','stage','next','received','barangay','updatedAt','schema'
      ]) && request.resource.data.kind == 'tracking'
        && request.resource.data.schema == 1
        && request.resource.data.state in ['active','disabled']
        && request.resource.data.applicationNo is string
        && request.resource.data.stage is string
        && request.resource.data.next is string
        && request.resource.data.received is string
        && request.resource.data.barangay is string
        && request.resource.data.updatedAt is string
        && request.resource.data.applicationNo.size() <= 70
        && request.resource.data.stage.size() <= 70
        && request.resource.data.next.size() <= 180
        && request.resource.data.barangay.size() <= 70;
    }
    function publicPermitShape() {
      return request.resource.data.keys().hasOnly([
        'kind','status','permitNo','permitType','issuedOn','barangay','updatedAt','schema'
      ]) && request.resource.data.keys().hasAll([
        'kind','status','permitNo','permitType','issuedOn','barangay','updatedAt','schema'
      ]) && request.resource.data.kind == 'permit'
        && request.resource.data.schema == 1
        && request.resource.data.status in ['valid','revoked','cancelled','unavailable']
        && request.resource.data.permitNo is string
        && request.resource.data.permitType is string
        && request.resource.data.issuedOn is string
        && request.resource.data.barangay is string
        && request.resource.data.updatedAt is string
        && request.resource.data.permitNo.size() <= 90
        && request.resource.data.permitType.size() <= 90
        && request.resource.data.barangay.size() <= 70;
    }
    match /publicTracking/{token} {
      allow get: if token.matches('^[A-Za-z0-9_-]{32}$');
      allow list: if false;
      allow create, update: if isAdmin()
        && token.matches('^[A-Za-z0-9_-]{32}$') && publicTrackingShape();
      allow delete: if isAdmin();
    }
    match /publicPermits/{token} {
      allow get: if token.matches('^[A-Za-z0-9_-]{32}$');
      allow list: if false;
      allow create, update: if isAdmin()
        && token.matches('^[A-Za-z0-9_-]{32}$') && publicPermitShape();
      allow delete: if isAdmin();
    }

    // v1.7 — INTERNAL annual commercial inspection and billing data.
    // Public applicant tracking users MUST NOT read these collections.
    // Authorized OBO admin is the only writer in this installation.
    match /annualBuildings/{buildingId} {
      allow get, list: if isStaff();
      allow create, update: if isAdmin()
        && request.resource.data.owner is string
        && request.resource.data.brgy is string
        && request.resource.data.reviewed is bool
        && request.resource.data.active is bool
        && request.resource.data.area is number
        && request.resource.data.area >= 0;
      // Retain identity and audit history of buildings used for annual billing.
      allow delete: if false;
    }
    match /annualConfig/{configId} {
      allow get, list: if isStaff();
      allow create, update: if isAdmin() && configId == 'current'
        && request.resource.data.approved is bool
        && request.resource.data.legalBasis is string
        && request.resource.data.brackets is list
        && request.resource.data.eachAbove1000 is number;
      allow delete: if false;
    }
    match /annualBills/{annualBillId} {
      allow get, list: if isStaff();
      allow create: if isAdmin()
        && request.resource.data.year is int
        && request.resource.data.buildingId is string
        && annualBillId == string(request.resource.data.year) + '__' + request.resource.data.buildingId
        && request.resource.data.state == 'draft'
        && request.resource.data.payments is list
        && request.resource.data.payments.size() == 0;
      allow update: if isAdmin()
        && request.resource.data.year == resource.data.year
        && request.resource.data.buildingId == resource.data.buildingId
        && request.resource.data.baseFee == resource.data.baseFee
        && request.resource.data.extraFee == resource.data.extraFee
        && request.resource.data.state in ['draft','issued','void']
        && request.resource.data.payments is list
        && request.resource.data.payments.size() >= resource.data.payments.size();
      // No removal: a voided bill reserves the annual building-year key.
      allow delete: if false;
    }
    match /annualReceipts/{receiptKey} {
      allow get, list: if isStaff();
      // A unique normalized OR number may be recorded exactly once.
      // All payments and the OR reservation are written atomically.
      allow create: if isAdmin()
        && request.resource.data.orNo is string
        && request.resource.data.billId is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow update, delete: if false;
    }
    match /annualAudit/{auditId} {
      allow get, list: if isStaff();
      allow create: if isAdmin()
        && request.resource.data.what is string
        && request.resource.data.ref is string
        && request.resource.data.by is string;
      // Append-only annual action history.
      allow update, delete: if false;
    }

    match /assessmentControl/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.high is int;
      allow update: if isStaff() && request.resource.data.high is int && (
        request.resource.data.high >= resource.data.high || isAdmin()
      );
      allow delete: if false;
    }
  }
}
